<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css">

    <title>{% block title %}My Web App{% endblock %}</title>
</head>
<body class="d-flex flex-column min-vh-100 bg-body-tertiary">

    <!--
        SITE NAVIGATION & BOOTSTRAP NAV
        https://jinja.palletsprojects.com/en/2.11.x/tricks/
        https://getbootstrap.com/docs/5.3/components/navbar/
    -->
    {% set nav_links = [
        ('/about', 'about', 'About'),
        ('/hello', 'hello', 'Hello'),
        ('/rps/form', 'rps_form', 'RPS Game'),
        ('/stocks/form', 'stocks_form', 'Stocks'),
    ] -%}
    {% set active_page = active_page|default('home') -%}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-semibold" href="/">
                <i class="bi bi-airplane me-2 text-warning fs-4"></i>
                My Web App
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                {% for href, page_id, link_text in nav_links %}
                    {% set is_active = "active" if (page_id == active_page or (page_id == 'rps_form' and active_page == 'rps_results') or (page_id == 'stocks_form' and active_page == 'stocks_dashboard')) else "" -%}
                    <li class="nav-item">
                        <a class="nav-link {{ is_active }}" href="{{ href }}"{% if is_active %} aria-current="page"{% endif %}>{{ link_text }}</a>
                    </li>
                {% endfor %}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        <!--
            FLASH MESSAGING
            https://flask.palletsprojects.com/en/1.1.x/patterns/flashing/
            https://getbootstrap.com/docs/5.3/components/alerts/
        -->
        {% with messages = get_flashed_messages(with_categories=true) %}
          {% if messages %}
            {% for category, message in messages %}
                <div class="alert alert-{{ category }} alert-dismissible fade show shadow-sm mb-4" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
          {% endif %}
        {% endwith %}

        <!--
            PAGE CONTENTS
        -->
        <div id="content">
            {% block content %}
            {% endblock %}
        </div>
    </main>

    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 text-body-secondary small">
            <span>&copy; 2026 My Web App</span>
            <a class="link-secondary text-decoration-none" href="https://github.com/prof-rossetti/intro-to-python/blob/main/exercises/web-app-2023/README.md">
                <i class="bi bi-github me-1"></i>Source
            </a>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js" integrity="sha384-WyOxWvTyr1QaMPfiPJSv76iReVthorl5uWlFtZPyK0IEB0hGzo9y5Bp9mYanr8Bu" crossorigin="anonymous"></script>
    <script type="text/javascript">

        console.log("Thanks for the page visit!")

    </script>
</body>
</html>